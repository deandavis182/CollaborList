# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=listapp
DB_USER=listuser
DB_PASSWORD=changeme-in-production

# Backend Configuration
JWT_SECRET=change-this-to-a-long-random-string-in-production
PORT=3001

# Google OAuth (optional for local, required for Google login)
# Get this from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend Configuration (for development)
FRONTEND_PORT=3000

# Web Push (optional — enables push notifications + the due-date reminder job).
# Generate a keypair with:  npx web-push generate-vapid-keys
# When these are absent the backend runs normally with push disabled (no-op).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@collaborlist.com